<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- ========================================================= -->
  <!-- Includes -->
  <!-- ========================================================= -->
  <xacro:include filename="$(find pal_gripper_description)/urdf/deg_to_rad.urdf.xacro"/>
  <xacro:include filename="$(find pal_gripper_description)/urdf/gripper.transmission.xacro"/>
  <xacro:include filename="$(find pal_gripper_description)/urdf/gripper.gazebo.xacro"/>
  <!-- ========================================================= -->
  <!-- Constants -->
  <!-- ========================================================= -->
  <xacro:property name="gripper_eps" value="0.001"/>
  <!-- ========================================================= -->
  <!-- PAL GRIPPER -->
  <!-- ========================================================= -->
  <xacro:macro name="pal_gripper" params="name parent *origin">
    <!-- ======================================================= -->
    <!-- Gripper body -->
    <!-- ======================================================= -->
    <link name="${name}_link">
      <inertial>
        <origin xyz="-0.000294 0.000291 -0.033086" rpy="0 0 0"/>
        <mass value="0.602660"/>
        <inertia ixx="0.000693" ixy="0.000045" ixz="-0.000000" iyy="0.001024" iyz="0.000000" izz="0.000672"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://pal_gripper_description/meshes/gripper_link.stl"/>
        </geometry>
        <material name="White"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://pal_gripper_description/meshes/gripper_link_collision.stl"/>
        </geometry>
      </collision>
    </link>
    <gazebo reference="${name}_link">
      <material>Gazebo/White</material>
    </gazebo>
    <joint name="${name}_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${name}_link"/>
    </joint>
    <!-- ======================================================= -->
    <!-- Right finger -->
    <!-- ======================================================= -->
    <link name="${name}_right_finger_link">
      <inertial>
        <origin xyz="-0.004470 0.010766 -0.121013" rpy="0 0 0"/>
        <mass value="0.109980"/>
        <inertia ixx="0.000232" ixy="-0.000005" ixz="-0.000032" iyy="0.000224" iyz="0.000036" izz="0.000029"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 3.1415"/>
        <geometry>
          <mesh filename="package://pal_gripper_description/meshes/gripper_finger_link.stl" scale="-1 -1 1"/>
        </geometry>
        <material name="Black"/>
      </visual>
      <collision>
        <origin xyz="0.005 0 -0.165" rpy="0 0 3.1415"/>
        <geometry>
          <box size="0.01 0.05 0.11"/>
        </geometry>
      </collision>
    </link>
    <gazebo reference="${name}_right_finger_link">
      <material>Gazebo/Black</material>
    </gazebo>
    <joint name="${name}_right_finger_joint" type="prismatic">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${name}_link"/>
      <child link="${name}_right_finger_link"/>
      <axis xyz="1 0 0"/>
      <limit effort="16" lower="0.0" upper="0.045" velocity="0.05"/>
      <calibration rising="0.0"/>
      <dynamics damping="80"/>
      <safety_controller k_position="20" k_velocity="20" soft_lower_limit="${0.0 + gripper_eps}" soft_upper_limit="${0.045 - gripper_eps}"/>
    </joint>
    <!-- ======================================================= -->
    <!-- Left finger -->
    <!-- ======================================================= -->
    <link name="${name}_left_finger_link">
      <inertial>
        <origin xyz="-0.004470 0.010766 -0.121013" rpy="0 0 0"/>
        <mass value="0.109980"/>
        <inertia ixx="0.000232" ixy="-0.000005" ixz="-0.000032" iyy="0.000224" iyz="0.000036" izz="0.000029"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 3.1415"/>
        <geometry>
          <mesh filename="package://pal_gripper_description/meshes/gripper_finger_link.stl"/>
        </geometry>
        <material name="Black"/>
      </visual>
      <collision>
        <origin xyz="-0.005 0 -0.165" rpy="0 0 3.1415"/>
        <geometry>
          <box size="0.01 0.05 0.11"/>
        </geometry>
      </collision>
    </link>
    <gazebo reference="${name}_left_finger_link">
      <material>Gazebo/Black</material>
    </gazebo>
    <joint name="${name}_left_finger_joint" type="prismatic">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${name}_link"/>
      <child link="${name}_left_finger_link"/>
      <axis xyz="-1 0 0"/>
      <limit effort="16" lower="0" upper="0.045" velocity="0.05"/>
      <calibration rising="0.0"/>
      <dynamics damping="80"/>
      <safety_controller k_position="20" k_velocity="20" soft_lower_limit="${0.0 + gripper_eps}" soft_upper_limit="${0.045 - gripper_eps}"/>
    </joint>
    <!-- ======================================================= -->
    <!-- Grasping frame -->
    <!-- ======================================================= -->
    <joint name="${name}_grasping_frame_joint" type="fixed">
      <parent link="${name}_link"/>
      <child link="${name}_grasping_frame"/>
      <origin xyz="0 0 -0.12" rpy="-1.5708 1.5708 0"/>
    </joint>
    <link name="${name}_grasping_frame">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.0001"/>
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
      </inertial>
    </link>
    <!-- ======================================================= -->
    <!-- EYE-IN-HAND RGB-D CAMERA -->
    <!-- ======================================================= -->
    <!-- Camera body is rigidly attached to the gripper. Current pose: xyz = 0 0 -0.05 rpy = 0 0 0 Change this transform according to the desired mounting position/orientation of the camera. -->
    <link name="${name}_eef_xtion_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.001"/>
        <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
      </inertial>
    </link>
    <joint name="${name}_eef_xtion_joint" type="fixed">
	    <origin xyz="0 0.1 -0.1" rpy="${-90 * deg_to_rad} ${90 * deg_to_rad} 0"/>
      <parent link="${name}_link"/>
      <child link="${name}_eef_xtion_link"/>
    </joint>
    <!-- ======================================================= -->
    <!-- RGB FRAME -->
    <!-- ======================================================= -->
    <link name="${name}_eef_xtion_rgb_frame"/>
    <joint name="${name}_eef_xtion_rgb_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${name}_eef_xtion_link"/>
      <child link="${name}_eef_xtion_rgb_frame"/>
    </joint>
    <!-- ======================================================= -->
    <!-- RGB OPTICAL FRAME -->
    <!-- ======================================================= -->
    <link name="${name}_eef_xtion_rgb_optical_frame"/>
    <joint name="${name}_eef_xtion_rgb_optical_joint" type="fixed">
	    <origin xyz="0 0 0" rpy="${0 * deg_to_rad} ${90 * deg_to_rad} ${0 * deg_to_rad}"/>
      <parent link="${name}_eef_xtion_rgb_frame"/>
      <child link="${name}_eef_xtion_rgb_optical_frame"/>
    </joint>
    <!-- ======================================================= -->
    <!-- DEPTH FRAME -->
    <!-- ======================================================= -->
    <link name="${name}_eef_xtion_depth_frame"/>
    <joint name="${name}_eef_xtion_depth_joint" type="fixed">
      <!-- No real-camera extrinsic calibration is used here. RGB and depth are coincident in simulation. -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${name}_eef_xtion_link"/>
      <child link="${name}_eef_xtion_depth_frame"/>
    </joint>
    <!-- ======================================================= -->
    <!-- DEPTH OPTICAL FRAME -->
    <!-- ======================================================= -->
    <link name="${name}_eef_xtion_depth_optical_frame"/>
    <joint name="${name}_eef_xtion_depth_optical_joint" type="fixed">
	    <origin xyz="0 0 0" rpy="${-90 * deg_to_rad} ${0 * deg_to_rad} ${-90 * deg_to_rad}"/>
      <parent link="${name}_eef_xtion_depth_frame"/>
      <child link="${name}_eef_xtion_depth_optical_frame"/>
    </joint>
    <!-- ======================================================= -->
    <!-- GAZEBO RGB-D SENSOR -->
    <!-- ======================================================= -->
    <gazebo reference="${name}_eef_xtion_link">
      <sensor type="depth" name="${name}_eef_xtion_sensor">
	<pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>
        <camera>
          <horizontal_fov> ${90.0*M_PI/180.0} </horizontal_fov>
          <image>
            <format>B8G8R8</format>
            <width>1080</width>
            <height>720</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>5.0</far>
          </clip>
        </camera>
        <!-- ================================================= -->
        <!-- PAL Gazebo OpenNI/Kinect plugin -->
        <!-- ================================================= -->
        <plugin name="${name}_eef_xtion_controller" filename="libgazebo_ros_openni_kinect.so">
          <alwaysOn>true</alwaysOn>
          <updateRate>30.0</updateRate>
          <cameraName>${name}_eef_xtion</cameraName>
          <imageTopicName> rgb/image_raw </imageTopicName>
          <cameraInfoTopicName> rgb/camera_info </cameraInfoTopicName>
          <depthImageTopicName> depth_registered/image_raw </depthImageTopicName>
          <depthImageCameraInfoTopicName> depth_registered/camera_info </depthImageCameraInfoTopicName>
          <pointCloudTopicName> depth_registered/points </pointCloudTopicName>
          <frameName> ${name}_eef_xtion_depth_optical_frame </frameName>
          <pointCloudCutoff>0.05</pointCloudCutoff>
          <pointCloudCutoffMax>5.0</pointCloudCutoffMax>
          <distortionK1>0.00000001</distortionK1>
          <distortionK2>0.00000001</distortionK2>
          <distortionK3>0.00000001</distortionK3>
          <distortionT1>0.00000001</distortionT1>
          <distortionT2>0.00000001</distortionT2>
        </plugin>
      </sensor>
    </gazebo>
    <!-- ======================================================= -->
    <!-- TRANSMISSIONS -->
    <!-- ======================================================= -->
    <xacro:gripper_simple_transmission name="${name}_left_finger" reduction="1.0"/>
    <xacro:gripper_simple_transmission name="${name}_right_finger" reduction="1.0"/>
    <!-- ======================================================= -->
    <!-- GAZEBO FINGER CONTROLLERS -->
    <!-- ======================================================= -->
    <xacro:finger_gazebo name="${name}_left_finger"/>
    <xacro:finger_gazebo name="${name}_right_finger"/>
  </xacro:macro>
</robot>
